\f0\fs24 \cf0 <!DOCTYPE html>\
<html>\
<head>\
  <meta name="viewport" content="width=device-width, initial-scale=1">\
  <title>Priority Weights</title>\
  <style>\
    body \{\
      font-family: Arial, sans-serif;\
      max-width: 500px;\
      margin: auto;\
      padding: 20px;\
    \}\
    h2 \{ text-align: center; \}\
\
    .row \{ margin-bottom: 20px; \}\
\
    .label \{\
      display: flex;\
      justify-content: space-between;\
      font-weight: bold;\
    \}\
\
    input[type=range] \{\
      width: 100%;\
    \}\
\
    .bar \{\
      height: 20px;\
      background: #ddd;\
      margin-top: 5px;\
      position: relative;\
    \}\
\
    .fill \{\
      height: 100%;\
      background: #4CAF50;\
    \}\
  </style>\
</head>\
\
<body>\
\
<h2>Set Your Priorities</h2>\
<p>Adjust sliders so total = 100%</p>\
\
<div class="row">\
  <div class="label">\
    <span>Pedestrian Density</span><span id="val0">33%</span>\
  </div>\
  <input type="range" min="0" max="100" value="33" oninput="update(0)">\
  <div class="bar"><div id="bar0" class="fill"></div></div>\
</div>\
\
<div class="row">\
  <div class="label">\
    <span>Crash Data</span><span id="val1">33%</span>\
  </div>\
  <input type="range" min="0" max="100" value="33" oninput="update(1)">\
  <div class="bar"><div id="bar1" class="fill"></div></div>\
</div>\
\
<div class="row">\
  <div class="label">\
    <span>Equity</span><span id="val2">34%</span>\
  </div>\
  <input type="range" min="0" max="100" value="34" oninput="update(2)">\
  <div class="bar"><div id="bar2" class="fill"></div></div>\
</div>\
\
<script>\
let sliders = document.querySelectorAll("input[type=range]");\
let values = [33, 33, 34];\
\
function update(changedIndex) \{\
  let total = 0;\
\
  sliders.forEach((s, i) => \{\
    values[i] = parseInt(s.value);\
    total += values[i];\
  \});\
\
  let diff = total - 100;\
\
  if (diff !== 0) \{\
    let others = sliders.length - 1;\
\
    sliders.forEach((s, i) => \{\
      if (i !== changedIndex) \{\
        let adjust = diff / others;\
        values[i] = Math.max(0, Math.min(100, values[i] - adjust));\
      \}\
    \});\
  \}\
\
  // normalize again to exactly 100\
  let sum = values.reduce((a,b) => a+b, 0);\
  values = values.map(v => Math.round(v * 100 / sum));\
\
  sliders.forEach((s, i) => \{\
    s.value = values[i];\
    document.getElementById("val"+i).innerText = values[i] + "%";\
    document.getElementById("bar"+i).style.width = values[i] + "%";\
  \});\
\}\
</script>\
\
</body>\
</html>}